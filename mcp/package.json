{
  "name": "@switchboard/mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server for Switchboard: feature flags as agent tools",
  "type": "module",
  "bin": { "switchboard-mcp": "dist/index.js" },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit && vitest run",
    "start": "node dist/index.js",
    "live-check": "node scripts/live-check.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
