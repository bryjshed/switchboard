  "cases": [
    {
      "name": "EQUALS matches the exact attribute value",
      "flagKey": "clause-equals",
      "context": {
        "key": "u",
        "attributes": {
          "plan": "pro"
        }
      },
      "expected": {
        "value": "false",
        "reason": "RULE_MATCH",
        "ruleId": "0c0c0c0c-0000-4000-8000-000000000001"
      }
    },
    {
      "name": "EQUALS does not match a different value",
      "flagKey": "clause-equals",
      "context": {
        "key": "u",
        "attributes": {
          "plan": "free"
        }
      },
      "expected": {
        "value": "true",
        "reason": "DEFAULT"
      }
    },
    {
      "name": "EQUALS is case sensitive",
      "flagKey": "clause-equals",
      "context": {
        "key": "u",
        "attributes": {
          "plan": "PRO"
        }
      },
      "expected": {
        "value": "true",
        "reason": "DEFAULT"
      }
    },
    {
      "name": "EQUALS does not substring match",
      "flagKey": "clause-equals",
      "context": {
        "key": "u",
        "attributes": {
          "plan": "pro-plus"
        }
      },
      "expected": {
        "value": "true",
        "reason": "DEFAULT"
      }
    },
    {
      "name": "a missing attribute fails the clause",
      "flagKey": "clause-equals",
      "context": {
        "key": "u",
        "attributes": {
          "region": "us"
        }
      },
      "expected": {
        "value": "true",
        "reason": "DEFAULT"
      }
    },
    {
      "name": "an empty attributes map fails the clause",
      "flagKey": "clause-equals",
      "context": {
        "key": "u",
        "attributes": {}
      },
      "expected": {
        "value": "true",
        "reason": "DEFAULT"
      }
    },
    {
      "name": "IN matches the first listed value",
      "flagKey": "clause-in",
      "context": {
        "key": "u",
        "attributes": {
          "region": "us"
        }
      },
      "expected": {
        "value": "false",
        "reason": "RULE_MATCH",
        "ruleId": "0c0c0c0c-0000-4000-8000-000000000001"
      }
    },
    {
      "name": "IN matches a later listed value",
      "flagKey": "clause-in",
      "context": {
        "key": "u",
        "attributes": {
          "region": "eu"
        }
      },
      "expected": {
        "value": "false",
        "reason": "RULE_MATCH",
        "ruleId": "0c0c0c0c-0000-4000-8000-000000000001"
      }
    },
    {
      "name": "IN does not match an unlisted value",
      "flagKey": "clause-in",
      "context": {
        "key": "u",
        "attributes": {
          "region": "apac"
        }
      },
      "expected": {
        "value": "true",
        "reason": "DEFAULT"
      }
    },
    {
      "name": "CONTAINS matches a substring from any listed value",
      "flagKey": "clause-contains",
      "context": {
        "key": "u",
        "attributes": {
          "email": "bob@example.com"
        }
      },
      "expected": {
        "value": "false",
        "reason": "RULE_MATCH",
        "ruleId": "0c0c0c0c-0000-4000-8000-000000000001"
      }
    },
    {
      "name": "CONTAINS matches the first listed value too",
      "flagKey": "clause-contains",
      "context": {
        "key": "u",
        "attributes": {
          "email": "bob@ex.com"
        }
      },
      "expected": {
        "value": "false",
        "reason": "RULE_MATCH",
        "ruleId": "0c0c0c0c-0000-4000-8000-000000000001"
      }
    },
    {
      "name": "CONTAINS does not match when no value is a substring",
      "flagKey": "clause-contains",
      "context": {
        "key": "u",
        "attributes": {
          "email": "bob@other.org"
        }
      },
      "expected": {
        "value": "true",
        "reason": "DEFAULT"
      }
    },
    {
      "name": "STARTS_WITH matches a prefix",
      "flagKey": "clause-starts-with",
      "context": {
        "key": "u",
        "attributes": {
          "email": "admin-bob@ex.com"
        }
      },
      "expected": {
        "value": "false",
        "reason": "RULE_MATCH",
        "ruleId": "0c0c0c0c-0000-4000-8000-000000000001"
      }
    },
    {
      "name": "STARTS_WITH does not match a mid-string occurrence",
      "flagKey": "clause-starts-with",
      "context": {
        "key": "u",
        "attributes": {
          "email": "bob-admin-@ex.com"
        }
      },
      "expected": {
        "value": "true",
        "reason": "DEFAULT"
      }
    },
    {
      "name": "the reserved attribute \"key\" reads the context key",
      "flagKey": "clause-key-attribute",
      "context": {
        "key": "beta-7",
        "attributes": {}
      },
      "expected": {
        "value": "false",
        "reason": "RULE_MATCH",
        "ruleId": "0c0c0c0c-0000-4000-8000-000000000001"
      }
    },
    {
      "name": "the reserved attribute \"key\" ignores an attribute named key",
      "flagKey": "clause-key-attribute",
      "context": {
        "key": "user-7",
        "attributes": {
          "key": "beta-7"
        }
      },
      "expected": {
        "value": "true",
        "reason": "DEFAULT"
      }
    },
    {
      "name": "a clause with no values never matches",
      "flagKey": "clause-empty-values",
      "context": {
        "key": "u",
        "attributes": {
          "plan": "pro"
        }
      },
      "expected": {
        "value": "true",
        "reason": "DEFAULT"
      }
    },
    {
      "name": "a rule matches only when ALL clauses match",
      "flagKey": "clause-conjunction",
      "context": {
        "key": "u",
        "attributes": {
          "plan": "pro",
          "region": "eu"
        }
      },
      "expected": {
        "value": "false",
        "reason": "RULE_MATCH",
        "ruleId": "0c0c0c0c-0000-4000-8000-000000000001"
      }
    },
    {
      "name": "one failing clause fails the whole rule",
      "flagKey": "clause-conjunction",
      "context": {
        "key": "u",
        "attributes": {
          "plan": "pro",
          "region": "apac"
        }
      },
      "expected": {
        "value": "true",
        "reason": "DEFAULT"
      }
    },
    {
      "name": "one missing attribute fails the whole rule",
      "flagKey": "clause-conjunction",
      "context": {
        "key": "u",
        "attributes": {
          "plan": "pro"
        }
      },
      "expected": {
        "value": "true",
        "reason": "DEFAULT"
      }
    },
    {
      "name": "a rule with no clauses matches every context",
      "flagKey": "clause-empty-rule",
      "context": {
        "key": "anyone",
        "attributes": {}
      },
      "expected": {
        "value": "false",
        "reason": "RULE_MATCH",
        "ruleId": "0c0c0c0c-0000-4000-8000-000000000001"
      }
