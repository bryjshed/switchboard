  "cases": [
    {
      "name": "an included key matches the segment",
      "flagKey": "seg-match",
      "context": {
        "key": "user-1",
        "attributes": {}
      },
      "expected": {
        "value": "false",
        "reason": "RULE_MATCH",
        "ruleId": "0c0c0c0c-0000-4000-8000-000000000001"
      }
    },
    {
      "name": "an excluded key loses even though a segment rule matches it",
      "flagKey": "seg-match",
      "context": {
        "key": "user-2",
        "attributes": {}
      },
      "expected": {
        "value": "true",
        "reason": "DEFAULT"
      }
    },
    {
      "name": "a segment rule matches by the reserved key attribute",
      "flagKey": "seg-match",
      "context": {
        "key": "user-3",
        "attributes": {}
      },
      "expected": {
        "value": "false",
        "reason": "RULE_MATCH",
        "ruleId": "0c0c0c0c-0000-4000-8000-000000000001"
      }
    },
    {
      "name": "a segment rule matches by attribute",
      "flagKey": "seg-any-of",
      "context": {
        "key": "someone",
        "attributes": {
          "plan": "pro"
        }
      },
      "expected": {
        "value": "false",
        "reason": "RULE_MATCH",
        "ruleId": "0c0c0c0c-0000-4000-8000-000000000001"
      }
    },
    {
      "name": "SEGMENT_MATCH lists are any-of and all can fail",
      "flagKey": "seg-any-of",
      "context": {
        "key": "someone",
        "attributes": {
          "plan": "free"
        }
      },
      "expected": {
        "value": "true",
        "reason": "DEFAULT"
      }
    },
    {
      "name": "no include, no exclude and no matching rule fails the segment",
      "flagKey": "seg-match",
      "context": {
        "key": "other-9",
        "attributes": {}
      },
      "expected": {
        "value": "true",
        "reason": "DEFAULT"
      }
    },
    {
      "name": "NOT_SEGMENT_MATCH inverts a segment hit",
      "flagKey": "seg-not-match",
      "context": {
        "key": "user-1",
        "attributes": {}
      },
      "expected": {
        "value": "true",
        "reason": "DEFAULT"
      }
    },
    {
      "name": "NOT_SEGMENT_MATCH matches a context outside the segment",
      "flagKey": "seg-not-match",
      "context": {
        "key": "other-9",
        "attributes": {}
      },
      "expected": {
        "value": "false",
        "reason": "RULE_MATCH",
        "ruleId": "0c0c0c0c-0000-4000-8000-000000000001"
      }
    },
    {
      "name": "an excluded key is outside the segment, so NOT_SEGMENT_MATCH matches it",
      "flagKey": "seg-not-match",
      "context": {
        "key": "user-2",
        "attributes": {}
      },
      "expected": {
        "value": "false",
        "reason": "RULE_MATCH",
        "ruleId": "0c0c0c0c-0000-4000-8000-000000000001"
      }
    },
    {
      "name": "an unknown segment key fails the clause instead of erroring",
      "flagKey": "seg-unknown",
      "context": {
        "key": "user-1",
        "attributes": {}
      },
      "expected": {
        "value": "true",
        "reason": "DEFAULT"
      }
    },
    {
      "name": "an unknown segment key under NOT_SEGMENT_MATCH matches, it does not error",
      "flagKey": "seg-not-match-unknown",
      "context": {
        "key": "user-1",
        "attributes": {}
      },
      "expected": {
        "value": "false",
        "reason": "RULE_MATCH",
        "ruleId": "0c0c0c0c-0000-4000-8000-000000000001"
      }
    },
    {
      "name": "a segment rule containing a segment operator never matches",
      "flagKey": "seg-nested",
      "context": {
        "key": "user-1",
        "attributes": {}
      },
      "expected": {
        "value": "true",
        "reason": "DEFAULT"
      }
    }
