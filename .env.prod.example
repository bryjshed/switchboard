# Environment for docker-compose.prod.yml. Copy to `.env` and edit.
#
#     cp .env.prod.example .env
#     docker compose -f docker-compose.prod.yml up --build -d --wait
#
# `.env` is gitignored. Every value below is a default that the compose file already applies
# EXCEPT POSTGRES_PASSWORD, which has none on purpose — compose refusing to start beats a
# production database with a default password.
#
# Full reference: docs/DEPLOYMENT.md

# ─── Database ────────────────────────────────────────────────────────────────────────────────
POSTGRES_DB=switchboard
POSTGRES_USER=switchboard
POSTGRES_PASSWORD=

# ─── Published ports ─────────────────────────────────────────────────────────────────────────
# 28081 (actuator) is deliberately not published. Health, info and prometheus live there and the
# port, not the filter chain, is the boundary.
BACKEND_PORT=28080
DASHBOARD_PORT=8080

# ─── The dashboard's view of the API ─────────────────────────────────────────────────────────
# Resolved by the USER'S BROWSER, not by the container — so never http://backend:28080. Getting
# this wrong presents as "the dashboard loads but nothing works".
PUBLIC_API_BASE_URL=http://localhost:28080

# ─── Identity ────────────────────────────────────────────────────────────────────────────────
# Which auth implementation is COMPILED INTO the dashboard bundle: `firebase` or `oidc`. A build
# argument, not a runtime setting — changing it means rebuilding the image, and the app says so
# rather than ignoring it.
VITE_AUTH_PROVIDER=firebase

# Firebase. NOTE there is no emulator variable here and there must not be: pointing the Admin SDK
# at an emulator in production means verifying real users' tokens against something that is not
# Google.
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=

# Generic OIDC, used only when the image was built with VITE_AUTH_PROVIDER=oidc. The backend
# needs the matching provider too — see docs/DEPLOYMENT.md for the SPRING_APPLICATION_JSON form.
# OIDC_AUTHORITY=https://acme.okta.com/oauth2/default
# OIDC_CLIENT_ID=
# OIDC_AUDIENCE=switchboard-api

# ─── Optional ────────────────────────────────────────────────────────────────────────────────
# Natural-language flag authoring. Healing, optimizing and the stale sweep work without it.
ANTHROPIC_API_KEY=

# Shared secret for POST /api/jobs/*. Empty closes the HTTP triggers; the in-process schedule is
# unaffected. Set it only if an external scheduler drives the jobs.
JOB_TOKEN=
JOBS_SCHEDULED_ENABLED=true

# Per credential, PER INSTANCE. Two instances mean twice these numbers.
RATELIMIT_ENABLED=true
RATELIMIT_RPM=6000
RATELIMIT_BURST=600

# Whole monthly partitions of eval_events / metric_events are DROPPED past this window. Lowering
# it takes effect on the next roll and there is no archive step.
EVENT_RETENTION_MONTHS=3
EVENT_PARTITION_MONTHS_AHEAD=2

# Tags both images. Useful for pinning a deploy to a build.
SWITCHBOARD_IMAGE_TAG=latest
