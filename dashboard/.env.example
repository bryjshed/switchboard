# Every value below is a default baked into the source — this file exists to document them and
# to give you somewhere to override. Copy to .env.local to change any of them.

# Switchboard management API
VITE_API_BASE_URL=http://localhost:28080

# ─── Auth provider ───────────────────────────────────────────────────────────────────────────
# `firebase` (default) or `oidc`. This is a BUILD-time choice: the unselected implementation is
# not bundled, so switching it means rebuilding, not just restarting.
VITE_AUTH_PROVIDER=firebase

# ─── VITE_AUTH_PROVIDER=firebase ─────────────────────────────────────────────────────────────
# Firebase Auth emulator. Blank this out to authenticate against real Firebase instead.
VITE_FIREBASE_AUTH_EMULATOR_HOST=http://localhost:29099

# Firebase project. The emulator ignores the API key's value but the web SDK requires one.
VITE_FIREBASE_PROJECT_ID=demo-switchboard
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-switchboard.firebaseapp.com
VITE_FIREBASE_APP_ID=demo-app-id

# ─── VITE_AUTH_PROVIDER=oidc ─────────────────────────────────────────────────────────────────
# The issuer, exactly as it appears in the token's `iss` claim and in the backend's
# `switchboard.auth.providers[].issuer`. Required.
# VITE_OIDC_AUTHORITY=https://acme.okta.com/oauth2/default

# The SPA application's client id at the IdP. Required. No client secret: a browser app is a
# public client and uses authorization code + PKCE.
# VITE_OIDC_CLIENT_ID=0oa1b2c3d4EXAMPLE

# Optional. Default: openid profile email
# VITE_OIDC_SCOPE=openid profile email

# Optional, but set it whenever the backend provider has an `audience`. Its presence also
# decides which token is sent: with an audience the resource-scoped ACCESS token, without one
# the ID token.
# VITE_OIDC_AUDIENCE=switchboard-api

# Optional. Default: the sign-in button reads "Sign in with <issuer host>".
# VITE_OIDC_PROVIDER_NAME=Acme SSO

# Optional. Default to this app's own origin + /auth/callback, /auth/silent-callback, /login.
# Set them only if the app is served under a path prefix or behind a different public origin.
# VITE_OIDC_REDIRECT_URI=https://switchboard.acme.com/auth/callback
# VITE_OIDC_SILENT_REDIRECT_URI=https://switchboard.acme.com/auth/silent-callback
# VITE_OIDC_POST_LOGOUT_REDIRECT_URI=https://switchboard.acme.com/login
