<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>com.switchboard</groupId>
    <artifactId>switchboard-backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>switchboard-backend</name>
    <description>Switchboard - AI-powered feature flag platform</description>

    <properties>
        <java.version>25</java.version>
        <openapi-generator.version>7.24.0</openapi-generator.version>
        <checkstyle.version>14.0.0</checkstyle.version>
        <maven-checkstyle-plugin.version>3.6.0</maven-checkstyle-plugin.version>
        <testcontainers-postgresql.version>2.0.5</testcontainers-postgresql.version>
        <anthropic-sdk.version>2.11.1</anthropic-sdk.version>
        <firebase-admin.version>9.7.0</firebase-admin.version>
    </properties>

    <dependencies>
        <!--
          The flag evaluation core, shared with every JVM SDK. Extracted so the server and an
          SDK cannot disagree about bucketing, operators or precedence - see
          docs/DECISIONS.md. JDK-only, so it adds nothing to the runtime here.
        -->
        <dependency>
            <groupId>com.switchboard</groupId>
            <artifactId>switchboard-evaluation</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-r2dbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <!--
              Generic OIDC verification: JWKS fetch + caching, signature, iss/aud/exp/nbf.
              Spring Security's own JOSE module rather than a third-party JWT library, so the
              decoder and its validators are the ones the framework already ships and tests.
            -->
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-oauth2-jose</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <!--
              Prometheus scrape format for the actuator. Without a registry implementation the
              actuator's /metrics endpoint reports only what the default simple registry holds,
              which is not scrapeable and not retained. Exposed on the management port only -
              see application.yml.
            -->
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>r2dbc-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <!-- Flyway runs on JDBC -->
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <!--
              Optional, and needed for exactly one thing: the Firebase Auth EMULATOR issues
              unsigned (alg: none) tokens that no JWKS verifier can accept. Production Firebase is
              an ordinary OIDC issuer and goes through OidcIdentityProvider. A deployment that
              authenticates against Okta, Auth0, Entra ID or Keycloak can delete this dependency;
              FirebaseEmulatorTokenVerifier is the only class that references it, and it is loaded
              only when a firebase provider is configured with FIREBASE_AUTH_EMULATOR_HOST set.
            -->
            <groupId>com.google.firebase</groupId>
            <artifactId>firebase-admin</artifactId>
            <version>${firebase-admin.version}</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>com.anthropic</groupId>
            <artifactId>anthropic-java</artifactId>
            <version>${anthropic-sdk.version}</version>
        </dependency>
        <dependency>
            <!-- Generated interfaces reference these annotations -->
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-annotations</artifactId>
            <version>2.2.30</version>
        </dependency>
        <dependency>
            <groupId>org.openapitools</groupId>
            <artifactId>jackson-databind-nullable</artifactId>
            <version>0.2.6</version>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <version>${testcontainers-postgresql.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.openapitools</groupId>
                <artifactId>openapi-generator-maven-plugin</artifactId>
                <version>${openapi-generator.version}</version>
                <executions>
                    <execution>
                        <id>generate-switchboard-api</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <inputSpec>${project.basedir}/src/main/resources/openapi/switchboard-api.yaml</inputSpec>
                            <skipIfSpecIsUnchanged>true</skipIfSpecIsUnchanged>
                            <generatorName>spring</generatorName>
                            <output>${project.build.directory}/generated-sources/openapi</output>
                            <apiPackage>com.switchboard.interfaces.rest.api</apiPackage>
                            <modelPackage>com.switchboard.interfaces.rest.model</modelPackage>
                            <generateModelTests>false</generateModelTests>
                            <generateModelDocumentation>false</generateModelDocumentation>
                            <generateApiTests>false</generateApiTests>
                            <generateApiDocumentation>false</generateApiDocumentation>
                            <generateSupportingFiles>false</generateSupportingFiles>
                            <configOptions>
                                <library>spring-boot</library>
                                <reactive>true</reactive>
                                <interfaceOnly>true</interfaceOnly>
                                <useSpringBoot3>true</useSpringBoot3>
                                <useTags>true</useTags>
                                <skipDefaultInterface>true</skipDefaultInterface>
                                <documentationProvider>none</documentationProvider>
                                <openApiNullable>false</openApiNullable>
                                <useOptional>false</useOptional>
                            </configOptions>
                            <typeMappings>
                                <typeMapping>DateTime=java.time.Instant</typeMapping>
                                <typeMapping>date=java.time.LocalDate</typeMapping>
                            </typeMappings>
                            <schemaMappings>
                                <schemaMapping>UUID=java.util.UUID</schemaMapping>
                                <!--
                                  OFREP shapes are bound by hand in
                                  com.switchboard.interfaces.rest.ofrep, so the generator must
                                  reference those records instead of emitting a second, lossier
                                  copy: OFREP types "value" as boolean|string|number|object and
                                  the bulk "flags" array as a success/failure union, neither of
                                  which survives generation intact. See OfrepController.
                                -->
                                <schemaMapping>OfrepEvaluationRequest=com.switchboard.interfaces.rest.ofrep.OfrepEvaluationRequest</schemaMapping>
                                <schemaMapping>OfrepContext=java.util.Map</schemaMapping>
                                <schemaMapping>OfrepEvaluationSuccess=com.switchboard.interfaces.rest.ofrep.OfrepEvaluationSuccess</schemaMapping>
                                <schemaMapping>OfrepEvaluationFailure=com.switchboard.interfaces.rest.ofrep.OfrepEvaluationFailure</schemaMapping>
                                <schemaMapping>OfrepFlagEvaluation=com.switchboard.interfaces.rest.ofrep.OfrepFlagEvaluation</schemaMapping>
                                <schemaMapping>OfrepBulkEvaluationResponse=com.switchboard.interfaces.rest.ofrep.OfrepBulkEvaluationResponse</schemaMapping>
                                <schemaMapping>OfrepEventStream=com.switchboard.interfaces.rest.ofrep.OfrepEventStream</schemaMapping>
                                <schemaMapping>OfrepEventStreamEndpoint=com.switchboard.interfaces.rest.ofrep.OfrepEventStreamEndpoint</schemaMapping>
                                <schemaMapping>OfrepSseEventData=com.switchboard.interfaces.rest.ofrep.OfrepSseEventData</schemaMapping>
                                <schemaMapping>OfrepGeneralError=com.switchboard.interfaces.rest.ofrep.OfrepGeneralError</schemaMapping>
                                <schemaMapping>OfrepReason=com.switchboard.interfaces.rest.ofrep.OfrepReason</schemaMapping>
                                <schemaMapping>OfrepErrorCode=com.switchboard.interfaces.rest.ofrep.OfrepErrorCode</schemaMapping>
                                <schemaMapping>OfrepMetadata=java.util.Map</schemaMapping>
                            </schemaMappings>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>${maven-checkstyle-plugin.version}</version>
                <dependencies>
                    <dependency>
                        <groupId>com.puppycrawl.tools</groupId>
                        <artifactId>checkstyle</artifactId>
                        <version>${checkstyle.version}</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <configLocation>../config/checkstyle/checkstyle.xml</configLocation>
                    <includeTestSourceDirectory>true</includeTestSourceDirectory>
                    <failOnViolation>true</failOnViolation>
                    <sourceDirectories>
                        <sourceDirectory>${project.build.sourceDirectory}</sourceDirectory>
                    </sourceDirectories>
                </configuration>
                <executions>
                    <execution>
                        <id>checkstyle-check</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludedGroups>integration</excludedGroups>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <groups>integration</groups>
                    <includes>
                        <include>**/*IT.java</include>
                    </includes>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
